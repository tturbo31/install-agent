ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCbmNph6atAoGfqLoCL_duAg
GITHUB_TOKEN=
SUPABASE_URL=
SUPABASE_ANON_KEY=
RESEND_API_KEY=
EMAIL_TO=ozzifloors@gmail.com

# Auto-learning memory store (Anthropic Memory Stores API)
# Leave empty on first run — the agent will create one and print the ID for you to save here.
# After the first run, paste the generated ID here so memory persists across daily runs.
MEMORY_STORE_ID=

# ── Custo & modelos (AAR #1/#2/#3 — todos opcionais, têm defaults sensatos) ──
# Model tiering: modelo "pesado" (análise estruturada final) e "leve" (análise por vídeo).
MODEL_DEEP=claude-opus-4-8
MODEL_LIGHT=claude-sonnet-4-6
# Batch API (−50%, assíncrono). true = job diário envia em lote; false (default) = síncrono.
USE_BATCH_API=false
# Ajustes do batch (só usados quando USE_BATCH_API=true):
BATCH_MAX_WAIT_MS=1200000
BATCH_POLL_INTERVAL_MS=15000

# ── Fontes multi-source (Reddit grátis; Google/LinkedIn/web via Firecrawl) ──
# Sem FIRECRAWL_API_KEY, Google/LinkedIn desligam sozinhos (Reddit continua de graça).
FIRECRAWL_API_KEY=
ENABLE_REDDIT=true
# ENABLE_* seguem a presença da key por padrão; force com true/false:
# ENABLE_GOOGLE=true
# ENABLE_LINKEDIN=true
# ENABLE_TWITTER=true
# ENABLE_INSTAGRAM=true
# Subreddits e queries (CSV) — opcional, têm defaults focados em Claude/IA:
# REDDIT_SUBREDDITS=ClaudeAI,Anthropic,LocalLLaMA,AI_Agents
# SEARCH_QUERIES=new Claude API features,Claude Code new features update,Anthropic MCP servers new
MAX_ITEMS_PER_SOURCE=6
SOURCE_DAYS_BACK=7
